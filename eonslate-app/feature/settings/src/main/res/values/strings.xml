    <string name="privacy_title">Privacy</string>
    <string name="privacy_collect_title">No data collection</string>
    <string name="privacy_collect">Eonslate does not collect or transmit any personal data, tracked entries, financial records, usage statistics or telemetry.</string>
    <string name="privacy_offline_title">Offline by design</string>
    <string name="privacy_offline">Eonslate does not have the internet permission, so it cannot send anything you track over the network.</string>
    <string name="privacy_where_title">Where your data lives</string>
    <string name="privacy_where">Your trackers and entries live in the app\'s private database on this device, and your settings in its private settings file. Other apps cannot read them, and uninstalling Eonslate deletes both.</string>
    <string name="privacy_permissions_title">Permissions</string>
    <string name="privacy_permissions">Eonslate asks for no permissions. If a future feature needs one, it will ask only when you turn that feature on, and say why first.</string>
    <string name="privacy_source_title">Source code</string>
    <string name="privacy_source">Eonslate\'s source code is public, so anyone can check how it handles your data.</string>
